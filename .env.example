# =============================================================================
# Переменные стека monitoring. Скопируйте в .env (файл в .gitignore):
#   cp .env.example .env
# На VPS .env создаётся один раз и живёт рядом с compose.yaml (/opt/monitoring).
# =============================================================================

# --- Grafana ----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# Обязательно. Сгенерировать: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# Публичный адрес панелей. По умолчанию — туннель на локальной машине.
# Если открываете Grafana через SSH-туннель на другом порту, поменяйте:
#   ssh -L 3001:127.0.0.1:3001 deploy@<vps>
GRAFANA_ROOT_URL=http://127.0.0.1:3001

# --- PostgreSQL ababawa -----------------------------------------------------
# Роль только для чтения статистики (см. postgres/monitor-role.sql).
ABABAWA_DB_MONITOR_USER=abv_monitor
# Обязательно. Сгенерировать: openssl rand -base64 24
ABABAWA_DB_MONITOR_PASSWORD=
# Имя базы в контейнере postgres.
ABABAWA_DB_NAME=abavava

# Docker-сеть прод-стека ababava, к которой подключается postgres_exporter
# (Postgres не публикует порт на хост). Имя по умолчанию складывается как
# <project>_<network> из compose.prod.yaml: "abavava" + "default".
# Проверить: docker network ls | grep abavava
ABABAWA_DOCKER_NETWORK=abavava_default
